{
  "allowPty": true,
  "supplyChain": {
    "installSandbox": true,
    "lifecycleScripts": {
      "enabled": true,
      "scanNodeModules": true,
      "blockUnsafePnpmConfig": true
    },
    "threatIntelligence": {
      "enabled": true,
      "blockPackageLookupAlerts": true,
      "promptOnBlock": true
    }
  },
  "network": {
    "allowedDomains": [
      "registry.npmjs.org"
    ],
    "packageLookup": {
      "provider": "socket-free",
      "ttlMs": 3600000,
      "timeoutMs": 5000
    },
    "deniedDomains": [],
    "allowLocalBinding": true,
    "allowLoopbackConnections": false,
    "allowLoopbackListeningHighPorts": [],
    "allowLoopbackPorts": [
      3000,
      3001,
      4983
    ],
    "allowUnixSockets": [
      "${GUARD_RUN_DIR}"
    ],
    "allowMachLookup": [
      "com.apple.FSEvents",
      "com.apple.fseventsd",
      "com.apple.FileCoordination"
    ]
  },
  "filesystem": {
    "denyRead": [
      "/Users",
      "/Volumes",
      "/Applications",
      "/cores",
      "/home"
    ],
    "allowRead": [
      "${GUARD_PROJECT_DIR}",
      "${GUARD_RUN_DIR}"
    ],
    "allowWrite": [
      "${GUARD_PROJECT_DIR}",
      "${GUARD_RUN_DIR}"
    ],
    "denyWrite": [
      ".env",
      ".env.*",
      "secrets/",
      "*.key",
      "*.pem"
    ]
  }
}
