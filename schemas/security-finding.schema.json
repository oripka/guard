{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guard.dev/schemas/security-finding.schema.json",
  "title": "Guard Security Finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "severity", "confidence", "title", "eventIds", "observations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "eventIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "maxLength": 500 }
    },
    "hypothesis": { "type": "string", "maxLength": 1000 },
    "coverageLimitations": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string", "maxLength": 500 }
    },
    "recommendedActions": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string", "maxLength": 500 }
    }
  }
}
