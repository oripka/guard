{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guard.dev/schemas/policy-proposal.schema.json",
  "title": "Guard Policy Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "type", "operation", "field", "value", "profile", "evidenceEventIds", "requiresHumanApproval"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "type": { "const": "guard.policy.proposal" },
    "operation": { "const": "add" },
    "field": {
      "enum": [
        "network.allowedDomains",
        "network.deniedDomains",
        "network.httpRules",
        "filesystem.allowRead",
        "filesystem.allowWrite",
        "filesystem.denyRead",
        "filesystem.denyWrite",
        "subprocess.allowExecutables",
        "subprocess.denyExecutables"
      ]
    },
    "value": {},
    "profile": { "type": "string", "minLength": 1, "maxLength": 160 },
    "evidenceEventIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    },
    "rationale": { "type": "string", "maxLength": 1000 },
    "requiresHumanApproval": { "const": true }
  }
}
